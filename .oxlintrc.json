{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/.packaging/**",
    "**/.stryker-tmp/**",
    "**/dist/**",
    "**/.nitro/**",
    "**/.output/**",
    "apps/server/.data/**",
    "**/coverage/**",
    "**/public/mockServiceWorker.js",
    "artifacts/**"
  ],
  "rules": {
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off"
  }
}
