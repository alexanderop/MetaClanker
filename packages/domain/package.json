    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@metaclanker/contracts": "workspace:*"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "typescript": "catalog:"
  }
}
